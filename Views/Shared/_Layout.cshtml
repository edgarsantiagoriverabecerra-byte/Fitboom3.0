@{
    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var usuarioNombre = Context.Session.GetString("UsuarioNombre") ?? "Usuario";
    var usuarioRol = Context.Session.GetString("UsuarioRol") ?? "Cliente";
    var usuarioFoto = Context.Session.GetString("UsuarioFoto") ?? "/images/imagen predeterminada.jpg";
    bool isAdmin = usuarioRol.ToLower().Contains("admin");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FITBOOM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #121212;
            color: #e0e0e0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        @if (isAdmin)
        {
            <text> display: flex;
                height: 100vh;
                overflow: hidden;
            </text>
        }
        }

        /* Estilos del Sidebar (Admin) */
        .app-sidebar {
            width: 260px;
            background-color: #181818;
            border-right: 1px solid #2a2a2a;
            display: flex;
            flex-direction: column;
            padding: 20px;
            box-sizing: border-box;
            height: 100vh;
        }

        .sidebar-brand {
            font-size: 1.2rem;
            font-weight: bold;
            color: #b6fb25;
            text-decoration: none;
            margin-bottom: 25px;
            letter-spacing: 1px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-grow: 1;
        }

            .sidebar-menu a {
                color: #b0b0b0;
                text-decoration: none;
                padding: 10px 15px;
                border-radius: 8px;
                font-size: 0.9rem;
                transition: 0.2s;
                display: block;
            }

                .sidebar-menu a:hover, .sidebar-menu a.active {
                    background-color: #b6fb25;
                    color: #121212;
                    font-weight: bold;
                }

        .sidebar-user {
            border-top: 1px solid #2a2a2a;
            padding-top: 15px;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Barra superior minimalista solo para el Botón Salir del Usuario */
        .user-topbar-minimal {
            background-color: #181818;
            border-bottom: 1px solid #2a2a2a;
            padding: 12px 35px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        /* Botón de Logout estilizado en Verde Neón FITBOOM */
        .btn-logout-fitboom {
            background: transparent;
            border: 1px solid rgba(182, 251, 37, 0.4);
            color: #b0b0b0;
            padding: 6px 16px;
            border-radius: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-decoration: none;
        }

            .btn-logout-fitboom:hover {
                background-color: rgba(182, 251, 37, 0.15);
                border-color: #b6fb25;
                color: #b6fb25;
            }

        .app-content {
            flex-grow: 1;
            overflow-y: auto;
            padding: 30px;
            background-color: #121212;
        }
    </style>
</head>
<body>

    @if (usuarioId != null && isAdmin)
    {
        <!-- LAYOUT LATERAL PARA ADMINISTRADOR -->
        <aside class="app-sidebar">
            <a href="#" class="sidebar-brand">FITBOOM ADMIN</a>
            <ul class="sidebar-menu">
                <li><a href="#" class="active">Dashboard</a></li>
                <li><a href="#">Usuarios</a></li>
                <li><a href="#">Profesionales</a></li>
                <li><a href="#">Membresías</a></li>
                <li><a href="#">Alimentos</a></li>
                <li><a href="#">Configuración</a></li>
            </ul>
            <div class="sidebar-user">
                <div style="display:flex; align-items:center; gap:10px; overflow:hidden;">
                    <img src="@usuarioFoto" alt="Foto" style="width:35px; height:35px; border-radius:50%; object-fit:cover;" />
                    <div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        <span style="font-size:0.85rem; color:#fff;">@usuarioNombre</span>
                        <small style="font-size:0.7rem; color:#888;">@usuarioRol</small>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    <button type="submit" class="btn-logout-fitboom" title="Cerrar sesión" style="padding: 6px 10px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    </button>
                </form>
            </div>
        </aside>
    }
    else if (usuarioId != null)
    {
        <!-- BARRA SUPERIOR MINIMALISTA (SOLO CON EL BOTÓN SALIR PARA QUE TUS VISTAS MANDEN EN LA NAVEGACIÓN) -->
        <header class="user-topbar-minimal">
            <div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0; display:inline;">
                    <button type="submit" class="btn-logout-fitboom" title="Cerrar Sesión">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Salir</span>
                    </button>
                </form>
            </div>
        </header>
    }

    <!-- CONTENEDOR PRINCIPAL -->
    <div style="@(isAdmin ? "display: flex; flex-direction: column; flex-grow: 1; height: 100vh; overflow: hidden;" : "width: 100%;")">
        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>