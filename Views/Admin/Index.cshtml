@model IEnumerable<FITBOOM.Models.Usuario>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";

    var totalUsuarios = ViewBag.TotalUsuarios ?? Model?.Count() ?? 0;
    var staffList = ViewBag.StaffList as List<FITBOOM.Models.Usuario>;
}
<style>
    .card-metric {
        background-color: #1f1f23;
        border: 1px solid #3f3f46;
        border-radius: 12px;
        padding: 1.25rem;
    }

    .card-dashboard {
        background-color: #1f1f23;
        border: 1px solid #3f3f46;
        border-radius: 16px;
        padding: 1.5rem;
    }

    .badge-activo {
        background-color: #14532d;
        color: #4ade80;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
    }

    .staff-card-item {
        background-color: #27272a;
        border: 1px solid #3f3f46;
        border-radius: 12px;
        transition: background-color 0.2s;
    }

        .staff-card-item:hover {
            background-color: #3f3f46;
        }

    .staff-avatar {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #ccff00;
    }
    /* Estilos corregidos para la tabla sin fondos blancos */
    .table-dark-custom {
        color: #f4f4f5 !important;
        background-color: transparent !important;
    }

        .table-dark-custom th {
            color: #a1a1aa !important;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 2px solid #3f3f46 !important;
            background-color: transparent !important;
            padding-bottom: 0.8rem;
        }

        .table-dark-custom td {
            color: #f4f4f5 !important;
            border-bottom: 1px solid #27272a !important;
            background-color: transparent !important;
            padding: 1rem 0.5rem;
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-dark-custom tr {
            background-color: transparent !important;
        }

    .btn-nuevo-plan {
        background-color: #27272a;
        color: #ccff00;
        border: 1px solid #3f3f46;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.4rem 0.9rem;
    }

        .btn-nuevo-plan:hover {
            background-color: #3f3f46;
            color: #ccff00;
        }

    .log-dot {
        width: 10px;
        height: 10px;
        background-color: #ccff00;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 10px #ccff00;
    }

    .log-dot-gray {
        width: 10px;
        height: 10px;
        background-color: #a1a1aa;
        border-radius: 50%;
        display: inline-block;
    }
</style></style>

<!-- Tarjetas Métricas Superiores -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card-metric shadow-sm">
            <span class="text-uppercase text-light fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Usuarios</span>
            <div class="d-flex align-items-baseline justify-content-between mt-2">
                <h3 class="fw-bold text-white mb-0" style="font-size: 1.8rem;">@totalUsuarios.ToString("N0")</h3>
                <span class="text-neon fw-bold small"><i class="bi bi-arrow-up-short fs-5"></i>12%</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card-metric shadow-sm">
            <span class="text-uppercase text-light fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Ingresos Mes</span>
            <div class="d-flex align-items-baseline justify-content-between mt-2">
                <h3 class="fw-bold text-white mb-0" style="font-size: 1.8rem;">$42.5M</h3>
                <span class="text-neon fw-bold small"><i class="bi bi-arrow-up-short fs-5"></i>8.4%</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card-metric shadow-sm">
            <span class="text-uppercase text-light fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Planes Pro/Elite</span>
            <div class="d-flex align-items-baseline justify-content-between mt-2">
                <h3 class="fw-bold text-white mb-0" style="font-size: 1.8rem;">64%</h3>
                <span class="text-light small fw-semibold">Ratio conversión</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card-metric shadow-sm">
            <span class="text-uppercase text-light fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Nuevos Hoy</span>
            <div class="d-flex align-items-baseline justify-content-between mt-2">
                <h3 class="fw-bold text-white mb-0" style="font-size: 1.8rem;">+124</h3>
                <span class="text-neon fw-bold small">+ Alta</span>
            </div>
        </div>
    </div>
</div>

<!-- Fila Central: Membresías y Nuestro Equipo (Dinámico) -->
<div class="row g-4 mb-4">
    <!-- Gestión de Membresías -->
    <div class="col-xl-8">
        <div class="card-dashboard h-100 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-white mb-0">Gestión de Membresías</h5>
                <a href="#" class="btn btn-nuevo-plan text-decoration-none">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Plan
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-dark-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre Plan</th>
                            <th>Precio</th>
                            <th>Usuarios</th>
                            <th>Estado</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold text-white">Básico</td>
                            <td class="text-light">$80,000</td>
                            <td class="text-light">4,520</td>
                            <td><span class="badge-activo">ACTIVO</span></td>
                            <td class="text-end">
                                <a href="#" class="text-light hover-white"><i class="bi bi-pencil-square fs-5"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-white">PRO</td>
                            <td class="text-light">$230,000</td>
                            <td class="text-light">6,120</td>
                            <td><span class="badge-activo">ACTIVO</span></td>
                            <td class="text-end">
                                <a href="#" class="text-light hover-white"><i class="bi bi-pencil-square fs-5"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-white">ÉLITE</td>
                            <td class="text-light">$900,000</td>
                            <td class="text-light">2,200</td>
                            <td><span class="badge-activo">ACTIVO</span></td>
                            <td class="text-end">
                                <a href="#" class="text-light hover-white"><i class="bi bi-pencil-square fs-5"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Nuestro Equipo (Administradores y Nutricionistas de la DB) -->
    <div class="col-xl-4">
        <div class="card-dashboard h-100 d-flex flex-column justify-content-between shadow-sm">
            <div>
                <h5 class="fw-bold text-white mb-3">Nuestro Equipo</h5>

                <div class="d-flex flex-column gap-2 mb-3">
                    @if (staffList != null && staffList.Any())
                    {
                        @foreach (var miembro in staffList.Take(3))
                        {
                            <div class="staff-card-item p-2 px-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" alt="Avatar" class="staff-avatar" />
                                    <div>
                                        <h6 class="fw-bold text-white mb-0" style="font-size: 0.95rem;">@miembro.Nombre @miembro.Apellido</h6>
                                        <small class="text-neon fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">@(miembro.Rol?.ToUpper() ?? "STAFF")</small>
                                    </div>
                                </div>
                                <i class="bi bi-three-dots text-light"></i>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-light small text-center py-3">No hay personal registrado con roles administrativos o de nutrición.</p>
                    }
                </div>
            </div>

            <div class="d-grid mt-2">
                <a asp-controller="Admin" asp-action="Profesionales" class="btn btn-dark border border-secondary text-white py-2 fw-semibold" style="font-size: 0.85rem; border-radius: 10px;">
                    Ver Todo El Equipo
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Logs de Actividad Reciente -->
<div class="row">
    <div class="col-12">
        <div class="card-dashboard shadow-sm">
            <h5 class="fw-bold text-white mb-4">Logs de Actividad Reciente</h5>

            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-start gap-3 border-bottom border-secondary pb-3">
                    <span class="log-dot mt-1"></span>
                    <div>
                        <p class="text-white mb-1" style="font-size: 0.95rem;">
                            Nuevo alimento añadido a la DB: <span class="text-neon fw-semibold">"Salmón salvaje"</span>
                        </p>
                        <small class="text-light opacity-75" style="font-size: 0.8rem;">Hace 12 min - Por Admin Central</small>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 border-bottom border-secondary pb-3">
                    <span class="log-dot-gray mt-1"></span>
                    <div>
                        <p class="text-white mb-1" style="font-size: 0.95rem;">
                            Plan nutricional actualizado para <span class="fw-bold text-white">Carlos Méndez (PRO)</span>
                        </p>
                        <small class="text-light opacity-75" style="font-size: 0.8rem;">Hace 45 min - Por Equipo Nutricional</small>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <span class="log-dot-gray mt-1"></span>
                    <div>
                        <p class="text-white mb-1" style="font-size: 0.95rem;">
                            Membresía ÉLITE renovada automáticamente <span class="fw-bold text-white">ID #9822</span>
                        </p>
                        <small class="text-light opacity-75" style="font-size: 0.8rem;">Hace 1 hora - Sistema Automático</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>