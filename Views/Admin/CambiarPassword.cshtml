@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header bg-transparent border-secondary text-white fw-bold">
                <i class="bi bi-key-fill me-2 text-neon"></i> Actualizar Contraseña
            </div>
            <div class="card-body">
                @if (TempData["MensajeError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["MensajeError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["MensajeExito"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["MensajeExito"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="CambiarPassword" method="post">
                    <div class="mb-3">
                        <label class="form-label text-white small fw-bold">Contraseña Actual</label>
                        <input type="password" name="passwordActual" class="form-control bg-secondary text-white border-0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white small fw-bold">Nueva Contraseña</label>
                        <input type="password" name="nuevoPassword" class="form-control bg-secondary text-white border-0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white small fw-bold">Confirmar Nueva Contraseña</label>
                        <input type="password" name="confirmarPassword" class="form-control bg-secondary text-white border-0" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-light btn-sm">Cancelar</a>
                        <button type="submit" class="btn btn-sm bg-neon text-dark fw-bold">
                            <i class="bi bi-check-lg me-1"></i> Actualizar Contraseña
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>