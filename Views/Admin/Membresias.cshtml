@{
    ViewData["Title"] = "Gestión de Membresías - FITBOOM";
}

<div style="background-color: #0f0f10; color: #ffffff; padding: 30px 20px; font-family: system-ui, -apple-system, sans-serif; min-height: 100vh; position: relative;">

    <!-- BARRA SUPERIOR / HEADER -->
    <header style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto 30px auto; padding: 0 10px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" alt="Admin" style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover;" />
            <div>
                <h3 style="margin: 0 0 2px 0; font-size: 16px; font-weight: 600;">Panel de Administración</h3>
                <span style="font-size: 12px; color: #a1a1aa;">FITBOOM • Gestión General</span>
            </div>
        </div>

        <nav style="background: #18181b; border: 1px solid #27272a; padding: 4px; border-radius: 30px; display: flex; gap: 6px; font-size: 13px;">
            <a asp-controller="Home" asp-action="Index" style="background: transparent; color: #a1a1aa; border: none; padding: 6px 16px; border-radius: 20px; text-decoration: none;">Inicio</a>
            <a asp-controller="Membresias" asp-action="Index" style="background: #bef264; color: #000; border: none; padding: 6px 16px; border-radius: 20px; font-weight: 600; text-decoration: none;">Membresías</a>
            <a href="#" style="background: transparent; color: #a1a1aa; border: none; padding: 6px 16px; border-radius: 20px; text-decoration: none;">Nutrición</a>
            <a href="#" style="background: transparent; color: #a1a1aa; border: none; padding: 6px 16px; border-radius: 20px; text-decoration: none;">Rutinas</a>
        </nav>

        <div>
            <a href="#" style="background: #18181b; border: 1px solid #27272a; color: #fff; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;">⚙️</a>
        </div>
    </header>

    <!-- CONTENEDOR PRINCIPAL: GESTIÓN DE MEMBRESÍAS -->
    <main style="max-width: 1000px; margin: 0 auto; background: #18181b; border: 1px solid #27272a; border-radius: 20px; padding: 24px;">

        <!-- CABECERA DE LA SECCIÓN -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="margin: 0; font-size: 18px; font-weight: 600; color: #fff;">Gestión de Membresías</h2>
            <!-- Redirige a la vista/acción Crear -->
            <a asp-controller="Membresias" asp-action="Crear" style="background: #bef264; color: #000; border: none; border-radius: 12px; padding: 10px 18px; font-size: 13px; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                + Nuevo Plan
            </a>
        </div>

        <!-- TABLA DE PLANES -->
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                <thead>
                    <tr style="color: #a1a1aa; font-size: 12px; border-bottom: 1px solid #27272a;">
                        <th style="padding-bottom: 14px; font-weight: 600;">NOMBRE PLAN</th>
                        <th style="padding-bottom: 14px; font-weight: 600;">PRECIO</th>
                        <th style="padding-bottom: 14px; font-weight: 600;">USUARIOS</th>
                        <th style="padding-bottom: 14px; font-weight: 600;">ESTADO</th>
                        <th style="padding-bottom: 14px; font-weight: 600; text-align: right;">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody style="color: #fff;">
                    <tr style="border-bottom: 1px solid #27272a;">
                        <td style="padding: 16px 0; font-weight: 600;">Básico</td>
                        <td style="padding: 16px 0; color: #d4d4d8;">$80,000</td>
                        <td style="padding: 16px 0; color: #d4d4d8;">4,520</td>
                        <td style="padding: 16px 0;"><span style="background: rgba(34, 197, 94, 0.15); color: #4ade80; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;">ACTIVO</span></td>
                        <td style="padding: 16px 0; text-align: right;">
                            <!-- Redirige a la vista Editar enviando el Id o nombre del plan -->
                            <a asp-controller="Membresias" asp-action="Editar" asp-route-id="1" style="background: #0f0f10; border: 1px solid #27272a; color: #fff; padding: 8px 12px; border-radius: 8px; text-decoration: none; display: inline-block;">✏️</a>
                        </td>
                    </tr>
                    <tr style="border-bottom: 1px solid #27272a;">
                        <td style="padding: 16px 0; font-weight: 600;">PRO</td>
                        <td style="padding: 16px 0; color: #d4d4d8;">$230,000</td>
                        <td style="padding: 16px 0; color: #d4d4d8;">6,120</td>
                        <td style="padding: 16px 0;"><span style="background: rgba(34, 197, 94, 0.15); color: #4ade80; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;">ACTIVO</span></td>
                        <td style="padding: 16px 0; text-align: right;">
                            <a asp-controller="Membresias" asp-action="Editar" asp-route-id="2" style="background: #0f0f10; border: 1px solid #27272a; color: #fff; padding: 8px 12px; border-radius: 8px; text-decoration: none; display: inline-block;">✏️</a>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 0; font-weight: 600;">ÉLITE</td>
                        <td style="padding: 16px 0; color: #d4d4d8;">$900,000</td>
                        <td style="padding: 16px 0; color: #d4d4d8;">2,200</td>
                        <td style="padding: 16px 0;"><span style="background: rgba(34, 197, 94, 0.15); color: #4ade80; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;">ACTIVO</span></td>
                        <td style="padding: 16px 0; text-align: right;">
                            <a asp-controller="Membresias" asp-action="Editar" asp-route-id="3" style="background: #0f0f10; border: 1px solid #27272a; color: #fff; padding: 8px 12px; border-radius: 8px; text-decoration: none; display: inline-block;">✏️</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </main>
</div>