@model IEnumerable<FITBOOM.Models.Usuario>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Profesionales";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-white mb-0"><i class="bi bi-person-badge text-neon me-2"></i>Equipo de Profesionales</h3>
        <p class="text-muted small mb-0">Entrenadores y nutricionistas de la plataforma.</p>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted border-bottom border-secondary small">
                        <th class="ps-3">Nombre</th>
                        <th>Correo</th>
                        <th>Especialidad / Rol</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-white">@p.Nombre @p.Apellido</td>
                                <td class="text-muted">@p.Correo</td>
                                <td>
                                    <span class="badge bg-warning text-dark fw-bold px-3 py-2">
                                        @(string.IsNullOrWhiteSpace(p.Rol) ? "Entrenador" : p.Rol)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No hay profesionales o entrenadores registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>