    <!-- Scripts de soporte -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Lógica de apertura/cierre de FitBot
        const toggleBtn = document.getElementById('fitbotToggleBtn');
        const closeBtn = document.getElementById('fitbotCloseBtn');
        const fitbotWindow = document.getElementById('fitbotWindow');

        toggleBtn.addEventListener('click', () => {
            fitbotWindow.style.display = fitbotWindow.style.display === 'flex' ? 'none' : 'flex';
        });

        closeBtn.addEventListener('click', () => {
            fitbotWindow.style.display = 'none';
        });

        // Interacción de preguntas rápidas
        function handleFitbotQuestion(titulo, targetId, respuesta) {
            const body = document.getElementById('fitbotBody');

            // Agregar mensaje del usuario
            const userMsg = document.createElement('div');
            userMsg.className = 'fitbot-msg user';
            userMsg.innerText = titulo;
            body.appendChild(userMsg);

            // Respuesta del bot
            setTimeout(() => {
                const botMsg = document.createElement('div');
                botMsg.className = 'fitbot-msg bot';
                botMsg.innerHTML = respuesta;
                body.appendChild(botMsg);
                body.scrollTop = body.scrollHeight;

                // Redireccionar/Desplazar suavemente a la sección correspondiente
                if (targetId) {
                    const section = document.querySelector(targetId);
                    if (section) {
                        section.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            }, 300);
        }
    </script>
